APP_NAME=RIMeF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://rimef.localhost:9280

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base centrale (conteneur rimef-mysql, voir .docker/.env)
DB_CONNECTION=mysql
DB_HOST=rimef-mysql
DB_PORT=3306
DB_DATABASE=rimef_central
DB_USERNAME=rimef
DB_PASSWORD=rimef

# Multi-tenant (stancl/tenancy)
# Domaines de l'espace central de supervision (séparés par des virgules)
CENTRAL_DOMAINS=supervisor.rimef.localhost,localhost,127.0.0.1
# Préfixe des bases tenant : rimef_tenant_<id>
TENANCY_DB_PREFIX=rimef_tenant_
# Domaine du tenant principal `rimef`
RIMEF_TENANT_DOMAIN=rimef.localhost

# Compte administratrice créé par `make tenants-db-seed` (environnement local uniquement)
RIMEF_DEV_ADMIN_EMAIL=admin@rimef.localhost
RIMEF_DEV_ADMIN_PASSWORD=rimef-dev-admin

# SPA servie sur le même domaine que l'API (cookie de session Sanctum)
SANCTUM_STATEFUL_DOMAINS=rimef.localhost:9280

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (capture des emails de dev : http://localhost:9826)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=rimef-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rimef.localhost"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
