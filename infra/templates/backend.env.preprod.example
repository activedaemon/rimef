# =============================================================================
# RIMeF backend — modèle .env de la PREPROD (recette)
# =============================================================================
# Gabarit de /srv/rimef/preprod/shared/.env, généré une fois par
# `make -f Makefile.prod preprod-bootstrap` (APP_KEY et DB_PASSWORD remplis
# automatiquement). Jamais versionné une fois rempli.
# =============================================================================

APP_NAME=RIMeF
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://rimef.active-daemon.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Base centrale (conteneur rimef-preprod-mysql)
DB_CONNECTION=mysql
DB_HOST=rimef-preprod-mysql
DB_PORT=3306
DB_DATABASE=rimef_central
DB_USERNAME=rimef
DB_PASSWORD=

# Multi-tenant : pas de supervision en preprod, seuls les accès internes sont centraux
CENTRAL_DOMAINS=localhost,127.0.0.1
TENANCY_DB_PREFIX=rimef_tenant_
RIMEF_TENANT_DOMAIN=rimef.active-daemon.com

# Médiatrices, événements et ressources fictifs pour la recette
RIMEF_DEMO_DATA=true

# Catalogue des emails de test (/api/dev/emails) : fermé (404) par défaut. Si
# true, il reste derrière le mot de passe nginx de /api/dev (make preprod-credentials).
RIMEF_DEV_TOOLS=false

# Comptes créés au premier déploiement. Mot de passe vide = aléatoire, puis
# « Mot de passe oublié » (email lisible dans Mailpit). Sans effet sur un compte
# qui existe déjà.
RIMEF_SUPERADMIN_EMAIL=david@active-daemon.com
RIMEF_SUPERADMIN_PASSWORD=
RIMEF_OLIVIA_EMAIL=ocaeymaex@c-r.org
RIMEF_OLIVIA_PASSWORD=

# Traefik puis nginx, sur des réseaux Docker (172.16.0.0/12) : IP réelle et https
TRUSTED_PROXIES=172.16.0.0/12

SANCTUM_STATEFUL_DOMAINS=rimef.active-daemon.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mailpit : aucun email ne sort du serveur (https://mail.rimef.active-daemon.com).
# Le bootstrap refuse de continuer si MAIL_HOST ne vise pas Mailpit.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=rimef-preprod-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="recette@rimef.active-daemon.com"
MAIL_FROM_NAME="${APP_NAME}"
