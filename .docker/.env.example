# Configuration Docker RIMeF - Développement
# Copier ce fichier vers .env et ajuster les valeurs
# (`make start` le copie automatiquement s'il est absent)

# USER_ID/GROUP_ID de l'utilisateur local pour les permissions Docker
# Exécutez `id -u` pour obtenir votre USER_ID et `id -g` pour votre GROUP_ID
# Cela garantit que les fichiers créés par Docker appartiennent à votre
# utilisateur et non à root
USER_ID=1000
GROUP_ID=1000

# MySQL (service rimef-mysql) — base centrale ; les bases tenant (rimef_tenant_*)
# sont créées par l'application
MYSQL_DATABASE=rimef_central
MYSQL_USER=rimef
MYSQL_PASSWORD=rimef
MYSQL_ROOT_PASSWORD=root
